# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Authentication (optional) ────────────────────────────────
# If AUTH_ENABLED=true, every request must include header: X-API-Key: <API_KEY>
AUTH_ENABLED=false
API_KEY=

# ── Google Gemini (required for /chat to generate answers) ───
GEMINI_API_KEY=

# ── Website analysis (optional overrides) ─────────────────────
SCRAPER_MAX_PAGES=15
SCRAPER_TIMEOUT_SECONDS=10
SCRAPER_USER_AGENT=OmniBrainBot/1.0 (+https://omnibrain.ai/bot)

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
